{
  "name": "portal-garage-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Portal Garage",
  "description": "Portal Garage — app desktop para Windows e macOS (login no site, PDV offline).",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --mac"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.portalgarage.desktop",
    "productName": "Portal Garage",
    "copyright": "Copyright Portal Garage",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "static/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
