generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       String       @id @default(uuid())
  name                     String
  slug                     String       @unique
  adminLogoDataUrl         String?      @db.LongText
  defaultCommissionPercent Float        @default(20)
  subscriptionPlanCode     String       @default("premium-full")
  subscriptionPlanName     String       @default("Premium Full")
  subscriptionStatus       String       @default("trialing")
  subscriptionMonthlyPriceCents Int     @default(19700)
  billingEmail             String?
  subscriptionStartedAt    DateTime?
  trialEndsAt              DateTime?
  nextBillingAt            DateTime?
  lastPaymentAt            DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  users              User[]
  garageSales        GarageSale[]
  contractTemplates  ContractTemplate[]
}

model ContractTemplate {
  id         String   @id @default(uuid())
  name       String
  type       String   // "service" or "inventory"
  text       String   @db.LongText
  parameters Json     // array of {name: string, type: string, required: boolean}
  createdBy  String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  garageSaleContractTemplates GarageSaleContractTemplate[]
  contractAcceptances         GarageSaleContractAcceptance[]

  @@index([tenantId])
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  passwordHash      String
  name              String?
  tenantId          String?
  tenant            Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isSuperAdmin      Boolean     @default(false)
  isActive          Boolean     @default(true)
  role              String      @default("staff")
  ownerGarageSaleId String?     @unique
  ownerGarageSale   GarageSale? @relation("GarageSaleOwner", fields: [ownerGarageSaleId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  contractAcceptances GarageSaleContractAcceptance[]

  @@index([tenantId])
}

model GarageSale {
  id                String    @id @default(uuid())
  slug              String?   @unique
  nome              String
  dataInicio        DateTime
  dataFim           DateTime?
  horarioInicio     String?
  horarioFim        String?
  endereco          String
  responsavel       String?
  email             String?
  regras            String?
  discount          Float?    @default(0)
  commissionPercent Float     @default(20)
  cep               String?
  cpf               String?
  pix               String?
  arScoreThreshold  Float     @default(0.72)
  reservationTTLMinutes Int   @default(30)
  createdAt         DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  itemsRegistrationComplete    Boolean   @default(false)
  itemsRegistrationCompletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  products            Product[]
  sales               Sale[]
  pendingOrders       PendingOrder[]
  ownerUser           User?                            @relation("GarageSaleOwner")
  contractTemplates   GarageSaleContractTemplate[]
  contractAcceptances GarageSaleContractAcceptance[]

  @@index([tenantId])
}

model GarageSaleContractTemplate {
  id           String     @id @default(uuid())
  garageSaleId String
  garageSale   GarageSale @relation(fields: [garageSaleId], references: [id], onDelete: Cascade)
  templateId   String
  template     ContractTemplate @relation(fields: [templateId], references: [id])
  filledParams Json       // object with param names as keys, values as filled values
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([garageSaleId, templateId])
  @@index([garageSaleId])
}

model GarageSaleContractAcceptance {
  id           String     @id @default(uuid())
  garageSaleId String
  garageSale   GarageSale @relation(fields: [garageSaleId], references: [id], onDelete: Cascade)
  signerUserId String
  signer       User       @relation(fields: [signerUserId], references: [id], onDelete: Cascade)
  templateId   String
  template     ContractTemplate @relation(fields: [templateId], references: [id])
  renderedBody String     @db.LongText
  signaturePng String     @db.LongText
  acceptedAt   DateTime   @default(now())

  @@unique([garageSaleId, templateId, signerUserId])
  @@index([garageSaleId])
}

model Product {
  id            String    @id @default(uuid())
  nome          String
  descricao     String?
  preco         Float
  imagens       Json      @default("[]")
  embedding     Json?
  categoria     String?
  condicao      String?
  tags          Json      @default("[]")
  status        String    @default("disponível")
  reservedBy    String?
  reservedByName String?
  reservedByEmail String?
  reservedByPhone String?
  reservedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  garageSaleId String
  garageSale   GarageSale @relation(fields: [garageSaleId], references: [id])
  saleItems    SaleItem[]

  @@index([garageSaleId])
}

model Sale {
  id           Int       @id @default(autoincrement())
  totalValue   Float
  date         DateTime  @default(now())
  buyerName    String?
  buyerPhone   String?
  buyerEmail   String?
  createdAt    DateTime  @default(now())
  clientSyncId String?   @unique @db.VarChar(191)

  garageSaleId String?
  garageSale   GarageSale? @relation(fields: [garageSaleId], references: [id])

  items    SaleItem[]
  payments Payment[]

  @@index([garageSaleId])
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  description     String
  price           Float
  quantity        Int
  saleId          Int
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  originalPrice   Float?
  discountPercent Float?
}

model Payment {
  id     Int    @id @default(autoincrement())
  method String
  amount Float
  saleId Int
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model PendingOrder {
  id            String   @id @default(uuid())
  customerName  String
  customerPhone String
  customerEmail String?
  total         Float
  status        String   @default("pending")
  isPaid        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  garageSaleId String
  garageSale   GarageSale @relation(fields: [garageSaleId], references: [id])

  items PendingOrderItem[]

  @@index([garageSaleId])
}

model PendingOrderItem {
  id             Int          @id @default(autoincrement())
  productId      String
  description    String
  price          Float
  quantity       Int
  pendingOrderId String
  pendingOrder   PendingOrder @relation(fields: [pendingOrderId], references: [id], onDelete: Cascade)
}
