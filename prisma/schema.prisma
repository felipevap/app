generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  garageSales GarageSale[]
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String?
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isSuperAdmin   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model GarageSale {
  id          String    @id @default(uuid())
  nome        String
  dataInicio  DateTime
  dataFim     DateTime?
  endereco    String
  responsavel String?
  email       String?
  regras      String?
  discount    Float?    @default(0)
  cep         String?
  cpf         String?
  pix         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  products      Product[]
  sales         Sale[]
  pendingOrders PendingOrder[]

  @@index([tenantId])
}

model Product {
  id                String    @id @default(uuid())
  nome              String
  descricao         String?
  preco             Float
  imagens           Json      @default("[]")
  categoria         String?
  condicao          String?
  tags              Json      @default("[]")
  status            String    @default("disponível")
  reservedBy        String?
  reservedByName    String?
  reservedByEmail   String?
  reservedByPhone   String?
  reservedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  garageSaleId String
  garageSale   GarageSale @relation(fields: [garageSaleId], references: [id])
  saleItems    SaleItem[]

  @@index([garageSaleId])
}

model Sale {
  id          Int       @id @default(autoincrement())
  totalValue  Float
  date        DateTime  @default(now())
  buyerName   String?
  buyerPhone  String?
  buyerEmail  String?
  createdAt   DateTime  @default(now())

  garageSaleId String?
  garageSale   GarageSale? @relation(fields: [garageSaleId], references: [id])

  items    SaleItem[]
  payments Payment[]

  @@index([garageSaleId])
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  description     String
  price           Float
  quantity        Int
  saleId          Int
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  originalPrice   Float?
  discountPercent Float?
}

model Payment {
  id     Int    @id @default(autoincrement())
  method String
  amount Float
  saleId Int
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model PendingOrder {
  id            String   @id @default(uuid())
  customerName  String
  customerPhone String
  customerEmail String?
  total         Float
  status        String   @default("pending")
  isPaid        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  garageSaleId String
  garageSale   GarageSale @relation(fields: [garageSaleId], references: [id])

  items PendingOrderItem[]

  @@index([garageSaleId])
}

model PendingOrderItem {
  id             Int          @id @default(autoincrement())
  productId      String
  description    String
  price          Float
  quantity       Int
  pendingOrderId String
  pendingOrder   PendingOrder @relation(fields: [pendingOrderId], references: [id], onDelete: Cascade)
}
