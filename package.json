{
  "name": "portal-garage",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed-super-admin": "npx tsx scripts/seed-super-admin.ts",
    "db:migrate": "prisma migrate deploy",
    "desktop:install": "npm install --prefix garage-desktop",
    "desktop:dist:win": "npm run dist:win --prefix garage-desktop",
    "desktop:dist:mac": "npm run dist:mac --prefix garage-desktop"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.34.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-webcam": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
